def merge_names(*names):
    return ", ".join(names) + "."
    
def merge_names(*names: str) -> str:
    """
    Merge multiple names into a single string, separating with commas,
    adding 'and' before the last name, and ending with a period.
    
    Args:
        *names: Variable number of string names.
    
    Returns:
        str: Nicely formatted string of names.
    """
    if not names:
        return ""
    if len(names) == 1:
        return f"{names[0]}."
    if len(names) == 2:
        return f"{names[0]} and {names[1]}."
    # For 3 or more names
    return f"{', '.join(names[:-1])}, and {names[-1]}."


